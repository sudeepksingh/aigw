root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h}]
indent_style = tab
indent_size = 8

[{Makefile,*.mk}]
indent_style = tab

[*.{sh,md,yml,yaml,json,txt,cmake}]
indent_style = space
indent_size = 2

[CMakeLists.txt]
indent_style = space
indent_size = 2

[*.{cmd,ps1}]
end_of_line = crlf
