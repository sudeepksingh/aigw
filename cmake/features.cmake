# AIGW OS features chosen when it is built (docs/features.md).
#
# The core is always built: devices, DNS and connection sensing, alerts and the
# domain-risk model, decisions (act), models and signed updates, the data model
# with USP and TR-069, Wi-Fi settings and firmware, Diagnose. Everything else is
# a feature, on by default (the full build). A feature that is off is not
# compiled: its commands, data model objects, settings and files go too.
#
#   cmake -DAIGW_PROFILE=small ...             a profile's features
#   cmake -DAIGW_FEATURE_MESH=OFF ...          one feature off (or on)
#
# A feature that needs another one off is an error that says which to turn on.

# name | what it is | the features it needs
set(AIGW_FEATURE_TABLE
  "WIFI_HEAL|Self-Healing Wi-Fi, band steering, channel healing, neighbour-aware channels|"
  "MESH|Smarter mesh Wi-Fi over an EasyMesh controller|"
  "COVERAGE|Coverage placement advice|WHY"
  "TR143|TR-143 diagnostics (IPPing, TraceRoute, Download, Upload, NSLookup)|"
  "CARE|Proactive care, checks, early warning, the experience score, the speed test|TR143"
  "UPGRADE|Firmware upgrades that check themselves and roll back|CARE"
  "WHY|Why was it slow, the home's timeline|"
  "OFFERS|Signals for the ISP (a faster plan, mesh Wi-Fi, and more)|WHY,CARE"
  "SQM|Self-tuning smart queueing|WHY"
  "CALLS|Calls and games first|SQM"
  "BRIEF|The help-desk brief|CARE,WHY"
  "PROACTIVE|Proactive care before the call, tickets to the ISP|BRIEF"
  "AREA|Area outages, fixes held while many homes fail at once|"
  "AREAPREDICT|Area fault prediction: line health trends, the shared plant found before it fails|CARE"
  "FED|Federated learning|"
  "FLEETLEARN|Fleet learning, every home teaches the next (fixes ranked by the fleet's outcomes, warnings from day one)|FED"
  "PLUGINS|Plug-ins and skills (MQTT, Home Assistant, the bridge to cortex)|"
  "SNI|Connection names from TLS and QUIC handshakes|"
  "METER|Per-device traffic meter (eBPF)|"
  "FASTPATH|Kernel fast path (flowtable)|"
  "REMOTE|Remote access over WireGuard|"
  "KEYS|Per-device Wi-Fi keys|"
  "PROVEN|Proven self-repair: every fix predicted, measured, and undone when it didn't help|CARE"
)

# profiles: full (everything, the default) | small (8/16 MB flash: what an ISP
# needs most) | minimal (the core only)
set(AIGW_PROFILE "full" CACHE STRING "Feature profile: full, small or minimal")
set_property(CACHE AIGW_PROFILE PROPERTY STRINGS full small minimal)
set(AIGW_PROFILE_small WIFI_HEAL TR143 CARE UPGRADE WHY BRIEF PROACTIVE SQM PROVEN AREAPREDICT)

set(AIGW_FEATURE_NAMES "")
foreach(row ${AIGW_FEATURE_TABLE})
  string(REPLACE "|" ";" f "${row}")
  list(GET f 0 name)
  list(GET f 1 what)
  list(LENGTH f n)
  set(needs "")
  if(n GREATER 2)
    list(GET f 2 needs)
    string(REPLACE "," ";" needs "${needs}")
  endif()
  if(AIGW_PROFILE STREQUAL "minimal")
    set(dflt OFF)
  elseif(AIGW_PROFILE STREQUAL "small")
    list(FIND AIGW_PROFILE_small ${name} k)
    if(k GREATER -1)
      set(dflt ON)
    else()
      set(dflt OFF)
    endif()
  elseif(AIGW_PROFILE STREQUAL "full")
    set(dflt ON)
  else()
    message(FATAL_ERROR "AIGW_PROFILE is full, small or minimal (not ${AIGW_PROFILE})")
  endif()
  option(AIGW_FEATURE_${name} "${what}" ${dflt})
  set(AIGW_NEEDS_${name} ${needs})
  list(APPEND AIGW_FEATURE_NAMES ${name})
endforeach()

# what each feature needs must be built too
set(AIGW_FEATURES_ON "")
set(AIGW_FEATURES_LIST "")
foreach(name ${AIGW_FEATURE_NAMES})
  if(AIGW_FEATURE_${name})
    foreach(need ${AIGW_NEEDS_${name}})
      if(NOT AIGW_FEATURE_${need})
        message(FATAL_ERROR "AIGW_FEATURE_${name} needs AIGW_FEATURE_${need}: turn it on, or turn ${name} off")
      endif()
    endforeach()
    list(APPEND AIGW_FEATURES_ON ${name})
    string(TOLOWER ${name} lower)
    string(REPLACE "_" "-" lower ${lower})
    if(AIGW_FEATURES_LIST)
      set(AIGW_FEATURES_LIST "${AIGW_FEATURES_LIST},${lower}")
    else()
      set(AIGW_FEATURES_LIST "${lower}")
    endif()
  endif()
endforeach()

# ag/features.h: AIGW_FEATURE_<NAME> 1 or 0 for the code, AG_FEATURES the list
set(AIGW_FEATURES_H "/* generated by cmake/features.cmake: the features this build has */\n")
string(APPEND AIGW_FEATURES_H "#ifndef AG_FEATURES_H\n#define AG_FEATURES_H\n")
foreach(name ${AIGW_FEATURE_NAMES})
  if(AIGW_FEATURE_${name})
    string(APPEND AIGW_FEATURES_H "#define AIGW_FEATURE_${name} 1\n")
  else()
    string(APPEND AIGW_FEATURES_H "#define AIGW_FEATURE_${name} 0\n")
  endif()
endforeach()
string(APPEND AIGW_FEATURES_H "#define AG_FEATURES \"${AIGW_FEATURES_LIST}\"\n#endif\n")
file(WRITE ${PROJECT_BINARY_DIR}/include/ag/features.h.new "${AIGW_FEATURES_H}")
configure_file(${PROJECT_BINARY_DIR}/include/ag/features.h.new ${PROJECT_BINARY_DIR}/include/ag/features.h COPYONLY)
list(LENGTH AIGW_FEATURES_ON n_on)
list(LENGTH AIGW_FEATURE_NAMES n_all)
message(STATUS "AIGW OS features (${n_on} of ${n_all}, profile ${AIGW_PROFILE}): ${AIGW_FEATURES_LIST}")

# sources of a feature: aigw_feature_sources(<list var> <FEATURE> files...)
function(aigw_feature_sources var feature)
  if(AIGW_FEATURE_${feature})
    set(${var} ${${var}} ${ARGN} PARENT_SCOPE)
  endif()
endfunction()
