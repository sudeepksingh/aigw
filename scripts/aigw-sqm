#!/bin/sh
# AIGW OS smart queueing (SQM) on the WAN, for agd's "sqm" decisions.
#
#   aigw-sqm apply <iface> <down_kbps> <up_kbps>   shape the line (0: that way not shaped)
#   aigw-sqm remove <iface>                         back to the kernel's default
#   aigw-sqm status <iface>                         "on <kind> <down> <up>" or "off"
#   aigw-sqm check                                  what this kernel can do: cake, htb, none
#
# Uploads are shaped on the interface itself, downloads on an ifb device the
# interface's ingress is redirected to. cake when the kernel has it (one
# qdisc that does both the shaping and the fairness), else htb with fq_codel.
# An SQM AIGW didn't set up (sqm-scripts, a person's own tc) is left alone.
# Exit 0 on success; the last line says what happened or why not.
set -u

STATE=${AIGW_SQM_STATE:-/tmp/aigw-sqm}
TC=$(command -v tc || echo /sbin/tc)
IP=$(command -v ip || echo /sbin/ip)

say() { echo "$*"; }
die() { echo "$*"; exit 1; }

ok_iface() {
	case $1 in
	''|*[!A-Za-z0-9._@-]*) return 1 ;;
	esac
	[ ${#1} -le 15 ] && [ -d "/sys/class/net/$1" ]
}
ok_rate() { case $1 in ''|*[!0-9]*) return 1 ;; esac; [ "$1" -le 10000000 ]; }
ifb_of() { echo "ifb4$(echo "$1" | cut -c1-11)"; }

kind() {   # what the kernel offers, tried on a throwaway device
	[ -x "$TC" ] || { echo none; return; }
	d=aigwsqmt$$
	$IP link add "$d" type dummy 2>/dev/null || { echo none; return; }
	if $TC qdisc add dev "$d" root cake bandwidth 1000kbit 2>/dev/null; then
		k=cake
	elif $TC qdisc add dev "$d" root handle 1: htb default 10 2>/dev/null &&
	     $TC class add dev "$d" parent 1: classid 1:10 htb rate 1000kbit 2>/dev/null &&
	     $TC qdisc add dev "$d" parent 1:10 fq_codel 2>/dev/null; then
		k=htb
	else
		k=none
	fi
	$IP link del "$d" 2>/dev/null
	echo "$k"
}

shape() {   # shape <dev> <kbps> <kind> [ingress]
	if [ "$3" = cake ]; then
		$TC qdisc replace dev "$1" root cake bandwidth "${2}kbit" besteffort ${4:+ingress}
	else
		$TC qdisc replace dev "$1" root handle 1: htb default 10 &&
		$TC class replace dev "$1" parent 1: classid 1:10 htb rate "${2}kbit" ceil "${2}kbit" &&
		$TC qdisc replace dev "$1" parent 1:10 fq_codel
	fi
}

remove() {
	$TC qdisc del dev "$1" root 2>/dev/null
	$TC qdisc del dev "$1" ingress 2>/dev/null
	$IP link del "$(ifb_of "$1")" 2>/dev/null
	rm -f "$STATE.$1"
}

ours() { [ -f "$STATE.$1" ]; }

foreign() {   # a shaping root qdisc on it that isn't AIGW's
	ours "$1" && return 1
	$TC qdisc show dev "$1" root 2>/dev/null | grep -q -E 'qdisc (cake|htb|hfsc|tbf|cbq)'
}

cmd=${1:-}
case $cmd in
check)
	kind
	;;
status)
	ok_iface "${2:-}" || die "no such interface: ${2:-}"
	if ours "$2" && { $TC qdisc show dev "$2"; $TC qdisc show dev "$(ifb_of "$2")"; } 2>/dev/null |
	   grep -q -E 'qdisc (cake|htb)'; then
		say "on $(cat "$STATE.$2")"
	else
		say off
	fi
	;;
apply)
	[ $# -eq 4 ] || die "usage: aigw-sqm apply <iface> <down_kbps> <up_kbps>"
	ok_iface "$2" || die "no such interface: $2"
	ok_rate "$3" && ok_rate "$4" || die "rates are kbit/s: $3 $4"
	[ "$3" -gt 0 ] || [ "$4" -gt 0 ] || die "nothing to shape"
	foreign "$2" && die "$2 already has smart queueing AIGW didn't set up (sqm-scripts?): left alone"
	k=$(kind)
	[ "$k" != none ] || die "this kernel has neither cake nor htb with fq_codel (OpenWRT: kmod-sched-cake kmod-ifb)"
	remove "$2"
	if [ "$4" -gt 0 ]; then
		shape "$2" "$4" "$k" || { remove "$2"; die "could not shape $2's upload"; }
	fi
	if [ "$3" -gt 0 ]; then
		ifb=$(ifb_of "$2")
		{ $IP link add "$ifb" type ifb && $IP link set "$ifb" up &&
		  $TC qdisc add dev "$2" handle ffff: ingress &&
		  $TC filter add dev "$2" parent ffff: matchall action mirred egress redirect dev "$ifb" &&
		  shape "$ifb" "$3" "$k" ingress; } 2>/dev/null || { remove "$2"; die "could not shape $2's download (ifb)"; }
	fi
	echo "$k $3 $4" > "$STATE.$2"
	say "on $k $3 $4: $2 shaped (download ${3} kbit/s, upload ${4} kbit/s)"
	;;
remove)
	ok_iface "${2:-}" || die "no such interface: ${2:-}"
	if ours "$2"; then
		remove "$2"
		say "off: $2 back to the kernel's default"
	else
		say "off: AIGW had nothing on $2"
	fi
	;;
*)
	die "usage: aigw-sqm apply <iface> <down_kbps> <up_kbps> | remove <iface> | status <iface> | check"
	;;
esac
