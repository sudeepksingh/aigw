#!/bin/sh
# aigw-nft: installs or removes the AIGW kernel rules (nftables table "inet ag").
#
#   aigw-nft apply    generate /etc/aigw/aigw.nft from UCI and load it
#   aigw-nft remove   unload the table (DNS and traffic go back to normal)
#   aigw-nft show     print the loaded table
#
# The same table works next to fw4 on OpenWRT (via a firewall include) and on
# a plain Linux PC acting as an access point.
set -eu

NFT_FILE=${AIGW_NFT_FILE:-/etc/aigw/aigw.nft}

uci_get() { uci ${AIGW_UCI_CONFDIR:+-c "$AIGW_UCI_CONFDIR"} -q get "aigw.$1" 2>/dev/null || true; }

render() {
	port=$(uci_get dns.port); port=${port:-5300}
	intercept=$(uci_get dns.intercept); intercept=${intercept:-1}
	ifaces=""
	for i in $(uci_get lan.iface); do
		[ -n "$ifaces" ] && ifaces="$ifaces, "
		ifaces="$ifaces\"$i\""
	done

	cat <<EOF
# Generated by aigw-nft. Do not edit; change /etc/config/aigw instead.
table inet ag
delete table inet ag
table inet ag {
	# Elements are added and removed by agd (agd/act.c), always with a timeout,
	# so every action ends on time even if agd stops.

	# quarantined devices (MAC): they reach the gateway (DHCP, DNS), nothing beyond
	set quarantine {
		type ether_addr
		flags timeout
	}

	# prioritised devices (IP): their traffic goes in the Wi-Fi video queue
	set priority4 {
		type ipv4_addr
		flags timeout
	}
	set priority6 {
		type ipv6_addr
		flags timeout
	}

	# connection-mark action byte -> verdict (see include/ag/mark.h)
	map action {
		type mark : verdict
		elements = { 0x00000005 : drop, 0x00000006 : drop }
	}

	chain forward {
		type filter hook forward priority filter - 5; policy accept;
		ether saddr @quarantine counter drop
		ct mark & 0x000000ff vmap @action
	}

	# DSCP CS5 = WMM "video" access category on the radio
	chain prioritize {
		type filter hook forward priority mangle; policy accept;
		ip saddr @priority4 counter ip dscp set cs5
		ip daddr @priority4 counter ip dscp set cs5
		ip6 saddr @priority6 counter ip6 dscp set cs5
		ip6 daddr @priority6 counter ip6 dscp set cs5
	}
EOF
	if [ "$intercept" = "1" ] && [ -n "$ifaces" ]; then
		cat <<EOF

	# send client DNS to agdns, whatever resolver the client asked for
	chain dns_intercept {
		type nat hook prerouting priority dstnat - 5; policy accept;
		iifname { $ifaces } meta l4proto { udp, tcp } th dport 53 redirect to :$port
	}
EOF
	fi
	echo "}"
}

case "${1:-}" in
apply)
	mkdir -p "$(dirname "$NFT_FILE")"
	render > "$NFT_FILE.tmp"
	nft -c -f "$NFT_FILE.tmp"
	mv "$NFT_FILE.tmp" "$NFT_FILE"
	nft -f "$NFT_FILE"
	;;
remove)
	mkdir -p "$(dirname "$NFT_FILE")"
	echo "# aigw is stopped" > "$NFT_FILE"
	nft delete table inet ag 2>/dev/null || true
	;;
show)
	nft list table inet ag
	;;
render)
	render
	;;
*)
	echo "usage: aigw-nft apply|remove|show|render" >&2
	exit 1
	;;
esac
