#!/bin/sh
# aigw-nft: installs or removes the AIGW kernel rules (nftables table "inet ag").
#
#   aigw-nft apply    generate /etc/aigw/aigw.nft from UCI and load it
#   aigw-nft remove   unload the table (DNS and traffic go back to normal)
#   aigw-nft show     print the loaded table
#
# The same table works next to fw4 on OpenWRT (via a firewall include) and on
# a plain Linux PC acting as an access point.
set -eu

NFT_FILE=${AIGW_NFT_FILE:-/etc/aigw/aigw.nft}

uci_get() { uci ${AIGW_UCI_CONFDIR:+-c "$AIGW_UCI_CONFDIR"} -q get "aigw.$1" 2>/dev/null || true; }

render() {
	port=$(uci_get dns.port); port=${port:-5300}
	intercept=$(uci_get dns.intercept); intercept=${intercept:-1}
	ifaces=""
	for i in $(uci_get lan.iface); do
		[ -n "$ifaces" ] && ifaces="$ifaces, "
		ifaces="$ifaces\"$i\""
	done

	cat <<EOF
# Generated by aigw-nft. Do not edit; change /etc/config/aigw instead.
table inet ag
delete table inet ag
table inet ag {
	# Elements are added and removed by agd (agd/act.c), always with a timeout,
	# so every action ends on time even if agd stops.

	# quarantined devices (MAC): they reach the gateway (DHCP, DNS), nothing beyond
	set quarantine {
		type ether_addr
		flags timeout
	}

	# prioritised devices (IP): their traffic goes in the Wi-Fi video queue
	set priority4 {
		type ipv4_addr
		flags timeout
	}
	set priority6 {
		type ipv6_addr
		flags timeout
	}

	# deprioritized devices (IP): their traffic goes in the Wi-Fi background queue
	set bulk4 {
		type ipv4_addr
		flags timeout
	}
	set bulk6 {
		type ipv6_addr
		flags timeout
	}

	# throttled devices (IP); agd writes one rate-limit rule per device into
	# chain "throttle", and each rule also checks this set, so it goes inert
	# when the element times out
	set throttle4 {
		type ipv4_addr
		flags timeout
	}
	set throttle6 {
		type ipv6_addr
		flags timeout
	}

	# connection-mark action byte -> verdict (see include/ag/mark.h)
	map action {
		type mark : verdict
		elements = { 0x00000005 : drop, 0x00000006 : drop }
	}

	chain forward {
		type filter hook forward priority filter - 5; policy accept;
		ether saddr @quarantine counter drop
		ct mark & 0x000000ff vmap @action
	}

	chain throttle {
		type filter hook forward priority filter - 4; policy accept;
	}

	# DSCP CS5 = WMM "video" access category on the radio, CS1 = "background"
	chain prioritize {
		type filter hook forward priority mangle; policy accept;
		ip saddr @priority4 counter ip dscp set cs5
		ip daddr @priority4 counter ip dscp set cs5
		ip6 saddr @priority6 counter ip6 dscp set cs5
		ip6 daddr @priority6 counter ip6 dscp set cs5
		ip saddr @bulk4 counter ip dscp set cs1
		ip daddr @bulk4 counter ip dscp set cs1
		ip6 saddr @bulk6 counter ip6 dscp set cs1
		ip6 daddr @bulk6 counter ip6 dscp set cs1
	}
EOF
	if [ "$intercept" = "1" ] && [ -n "$ifaces" ]; then
		cat <<EOF

	# send client DNS to agdns, whatever resolver the client asked for
	chain dns_intercept {
		type nat hook prerouting priority dstnat - 5; policy accept;
		iifname { $ifaces } meta l4proto { udp, tcp } th dport 53 redirect to :$port
	}
EOF
	fi
	echo "}"
}

# Server names for connections (agd/sni.c): the first packets of each new
# HTTPS connection (the TLS ClientHello, the QUIC Initial) are copied to agd
# over NFLOG. A copy, never a verdict: forwarding never waits for agd. Needs
# nft_log and nfnetlink_log (kmod-nfnetlink-log on OpenWRT).
render_sni() {
	[ "$(uci_get flow.sni)" = 0 ] && return 0
	[ "$(uci_get flow.enabled)" = 0 ] && return 0
	grp=$(uci_get flow.sni_group); grp=${grp:-4419}
	from=""
	ifaces=""
	for i in $(uci_get lan.iface); do
		[ -n "$ifaces" ] && ifaces="$ifaces, "
		ifaces="$ifaces\"$i\""
	done
	[ -n "$ifaces" ] && from="iifname { $ifaces } "
	cat <<EOF

table inet ag_sni
delete table inet ag_sni
table inet ag_sni {
	chain forward {
		type filter hook forward priority filter - 6; policy accept;
		${from}tcp dport 443 ct original packets 3-6 log group $grp snaplen 2048 queue-threshold 1
		${from}udp dport 443 ct original packets 1-3 log group $grp snaplen 2048 queue-threshold 1
	}
}
EOF
}

# Fast path (agd/fastpath.c): established connections, past their first
# packets, of devices AIGW isn't acting on go through the kernel flowtable and
# skip the forwarding rules ("offload 1": the switch chip, where there is one).
# A device under an action stays on the slow path: agd sends its offloaded
# connections back when the action starts. Needs nf_flow_table
# (kmod-nft-offload on OpenWRT); turn fw4's own flow offloading off, or it
# offloads devices AIGW is acting on.
render_fastpath() {
	[ "$(uci_get fastpath.enabled)" = 1 ] || return 0
	devs=$(uci_get fastpath.ifaces)
	if [ -z "$devs" ]; then
		devs="$(uci_get lan.iface) $(ip route show default 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -1)"
	fi
	list=""
	for i in $devs; do
		ip link show "$i" > /dev/null 2>&1 || continue
		case " $list " in *"\"$i\""*) continue ;; esac
		[ -n "$list" ] && list="$list, "
		list="$list\"$i\""
	done
	[ -n "$list" ] || return 0
	flags=""
	[ "$(uci_get fastpath.offload)" = 1 ] && flags="flags offload;"
	cat <<EOF

table inet ag {
	flowtable fast {
		hook ingress priority filter
		devices = { $list }
		$flags
		counter
	}

	# after the action chains (filter - 5, - 4) and the handshake copies
	chain fastpath {
		type filter hook forward priority filter + 5; policy accept;
		ct state != established return
		ct original packets < 8 return
		ct mark & 0x000000ff != 0 return
		ether saddr @quarantine return
		ip saddr @priority4 return
		ip daddr @priority4 return
		ip saddr @bulk4 return
		ip daddr @bulk4 return
		ip saddr @throttle4 return
		ip daddr @throttle4 return
		ip6 saddr @priority6 return
		ip6 daddr @priority6 return
		ip6 saddr @bulk6 return
		ip6 daddr @bulk6 return
		ip6 saddr @throttle6 return
		ip6 daddr @throttle6 return
		meta l4proto { tcp, udp } counter flow add @fast
	}
}
EOF
}

# Quarantine inside a bridge (e.g. br-lan on OpenWRT): frames between two LAN
# ports never reach the inet forward hook. Needs nft bridge support in the
# kernel (kmod-nft-bridge on OpenWRT); skipped where it is missing.
render_bridge() {
	cat <<EOF
table bridge ag
delete table bridge ag
table bridge ag {
	set quarantine {
		type ether_addr
		flags timeout
	}

	chain forward {
		type filter hook forward priority filter - 5; policy accept;
		ether saddr @quarantine counter drop
		ether daddr @quarantine counter drop
	}
}
EOF
}

case "${1:-}" in
apply)
	mkdir -p "$(dirname "$NFT_FILE")"
	render > "$NFT_FILE.tmp"
	nft -c -f "$NFT_FILE.tmp"
	# connection names ride along only where the kernel takes them, so the
	# file (also the fw4 include on OpenWRT) always loads
	render_sni > "$NFT_FILE.sni"
	if [ -s "$NFT_FILE.sni" ]; then
		cat "$NFT_FILE.tmp" "$NFT_FILE.sni" > "$NFT_FILE.both"
		if nft -c -f "$NFT_FILE.both" 2>/dev/null; then
			mv "$NFT_FILE.both" "$NFT_FILE.tmp"
		else
			echo "aigw-nft: no NFLOG support (nft_log, nfnetlink_log): connections are named from DNS only" >&2
			rm -f "$NFT_FILE.both"
			nft delete table inet ag_sni 2>/dev/null || true
		fi
	else
		nft delete table inet ag_sni 2>/dev/null || true
	fi
	rm -f "$NFT_FILE.sni"
	render_fastpath > "$NFT_FILE.fast"
	if [ -s "$NFT_FILE.fast" ]; then
		cat "$NFT_FILE.tmp" "$NFT_FILE.fast" > "$NFT_FILE.both"
		if nft -c -f "$NFT_FILE.both" 2>/dev/null; then
			mv "$NFT_FILE.both" "$NFT_FILE.tmp"
		elif grep -q "flags offload" "$NFT_FILE.fast" &&
		     sed '/flags offload;/d' "$NFT_FILE.fast" | cat "$NFT_FILE.tmp" - > "$NFT_FILE.both" &&
		     nft -c -f "$NFT_FILE.both" 2>/dev/null; then
			echo "aigw-nft: no hardware flow offload here; fast path in software" >&2
			mv "$NFT_FILE.both" "$NFT_FILE.tmp"
		else
			echo "aigw-nft: no flowtable support (nf_flow_table, kmod-nft-offload): no fast path" >&2
			rm -f "$NFT_FILE.both"
		fi
	fi
	rm -f "$NFT_FILE.fast"
	mv "$NFT_FILE.tmp" "$NFT_FILE"
	nft -f "$NFT_FILE"
	render_bridge > "$NFT_FILE.bridge"
	if nft -c -f "$NFT_FILE.bridge" 2>/dev/null; then
		nft -f "$NFT_FILE.bridge"
	else
		echo "aigw-nft: no nft bridge support; quarantine covers routed traffic only" >&2
	fi
	;;
remove)
	mkdir -p "$(dirname "$NFT_FILE")"
	echo "# aigw is stopped" > "$NFT_FILE"
	rm -f "$NFT_FILE.bridge"
	nft delete table inet ag 2>/dev/null || true
	nft delete table inet ag_sni 2>/dev/null || true
	nft delete table bridge ag 2>/dev/null || true
	;;
show)
	nft list table inet ag
	nft list table inet ag_sni 2>/dev/null || true
	nft list table bridge ag 2>/dev/null || true
	;;
render)
	render
	render_sni
	render_fastpath
	render_bridge
	;;
render-sni)
	render_sni
	;;
*)
	echo "usage: aigw-nft apply|remove|show|render|render-sni" >&2
	exit 1
	;;
esac
