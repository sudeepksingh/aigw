# AIGW configuration (UCI format, same file on OpenWRT and on a PC as AP).
# Location: /etc/config/aigw    Apply changes: restart the service.

config aigw 'main'
	option enabled '1'
	option log_level 'info'
	# DHCP leases file; leave unset for the platform default
	# option leases '/tmp/dhcp.leases'
	# device history; '' turns saving off. OpenWRT saves hourly to spare flash.
	# option state_file '/etc/aigw/agd-state.json'
	# option state_interval '3600'

config dns 'dns'
	# agdns listens here; client DNS on the LAN interfaces is redirected to it
	option listen '0.0.0.0'
	option port '5300'
	# 'auto' = dnsmasq on OpenWRT, first resolv.conf nameserver elsewhere.
	# Or an address: '1.1.1.1' / '9.9.9.9#53'
	option upstream 'auto'
	option intercept '1'

config flow 'flow'
	# what devices connect to and how much they transfer (conntrack)
	option enabled '1'
	# seconds between traffic counter refreshes
	option poll '30'
	# seconds after start before flagging "connection without a DNS lookup"
	option warmup '600'

config alerts 'alerts'
	# alerts explain what AIGW noticed; acting on them is set in 'act' below
	option enabled '1'
	# domain-risk score (0-1) at which a lookup is called machine-generated
	option dga_threshold '0.98'
	# shorter registrable names are not judged
	option dga_min_label '8'

config baseline 'baseline'
	# what is normal for each device, learned continuously
	# watch a device this long, and until it has used this many sites, before judging it
	option learn_minutes '1440'
	option min_known '20'
	# devices picking up fewer new sites per day count as "stable" (IoT);
	# only they raise new-destination alerts (phones and laptops don't)
	option novelty_max '2'
	# upload alert: this many standard deviations above usual, and at least this many MB in an hour
	option spike_factor '6'
	option spike_min_mb '50'
	# days of history before "active at an unusual hour" alerts
	option unusual_min_days '7'

config act 'act'
	# What AIGW may do about what it notices:
	#   off      alerts only, no actions proposed
	#   advise   policies propose actions; nothing changes until you approve
	#            (agctl decisions / agctl approve <id>)
	#   enforce  policies act on their own, within the guardrails below
	option mode 'advise'
	# every action ends by itself: default and maximum life, in seconds
	option ttl '3600'
	option max_ttl '86400'
	# enforce mode: at most this many automatic actions per hour, then they wait for you
	option max_auto_per_hour '3'
	# default speed limit for 'throttle', kbit/s
	option throttle_kbps '2000'
	# devices AIGW never acts on (MAC, IP or name), e.g. your own laptop
	# list protect 'aa:bb:cc:dd:ee:ff'
	# block list agdns reads; leave unset for the platform default (in RAM)
	# option dns_policy '/run/aigw/dns-policy'

# Policies: when an alert is raised, which action to propose. A policy's own
# mode can only be weaker than act.mode. Actions: quarantine, disconnect,
# throttle (with option rate, kbit/s), deprioritize, priority, or a plug-in's
# action ("<plugin>.<action>", see agctl plugins). 'option zone iot' limits a
# policy to devices in that zone. Skills (plug-ins) bring policies of their own.
# (Blocking a domain is never automatic: run 'agctl block <domain>'.)
# Without any policy sections, these three are built in.
config policy 'dga'
	option alert 'dga'
	option action 'quarantine'
	option ttl '3600'

config policy 'iot_new_site'
	# only "stable" devices (cameras, plugs, TVs) raise new-destination alerts
	option alert 'new-destination'
	option action 'quarantine'

config policy 'known_threat'
	# a name on the shared threat list from cortex (agctl models: threat-intel)
	option alert 'known-threat'
	option action 'quarantine'
	option ttl '3600'

# config policy 'upload_spike'
#	option alert 'upload-spike'
#	option action 'throttle'
#	option rate '1000'
#	option mode 'advise'

config wifi 'wifi'
	# hostapd control sockets; leave unset for the platform default
	# option ctrl_dir '/var/run/hostapd'
	# per-device Wi-Fi keys (agctl key add <name>): agd keeps them in this
	# hostapd wpa_psk_file. PC as AP sets it up; on OpenWRT add to the Wi-Fi
	# interface: uci set wireless.default_radio0.wpa_psk_file='/etc/aigw/wifi-keys'
	# option keys '/etc/aigw/wifi-keys'
	# an unused key expires after this many seconds
	# option key_ttl '86400'

config plugins 'plugins'
	# Plug-ins wire themselves in, no configuration needed: packages put them
	# in /usr/share/aigw/plugins (trusted); 'agctl plugin add <folder>' puts
	# yours in /etc/aigw/plugins, whose privileged capabilities wait for
	# 'agctl plugin allow <name>'. See: agctl plugins
	option enabled '1'
	# plug-ins run as this unprivileged user
	option user 'nobody'
	# each plug-in's own writable directory is <state_dir>/<name>
	# option state_dir '/var/run/aigw/plugins'

# Settings for one plug-in become its configuration; 'enabled 0' turns it off.
# 'agctl plugin config <name> <key> <value>' sets them and restarts the plug-in.
# config plugin 'mqtt'
#	option broker '192.168.1.10'
#	option port '1883'
#	option username 'aigw'
#	option password 'secret'
#	option homeassistant '1'

# The bridge to cortex (package aigw-bridge): 'agctl bridge <url>', then
# 'agctl bridge token' (paste the token from 'aigw_cortex enroll').
# config plugin 'bridge'
#	option url 'https://cortex.example.net:8790'
#	option token '...'
#	option interval '300'
#	# names | anonymous (no names, addresses or alert reasons) | none
#	option devices 'names'
#	option models '1'
#	option proposals '1'

config remote 'remote'
	# Remote access over WireGuard: 'agctl remote on <public address or DDNS
	# name>', then 'agctl remote add <name>' for a QR code. Behind another
	# router, forward UDP <port> to this gateway.
	option enabled '0'
	# option endpoint 'home.example.net'
	# option port '51820'
	# option subnet '10.77.0.0/24'
	# 1: all of a phone's traffic goes home, so AIGW protects it everywhere;
	# 0: only the tunnel and the home networks
	# option full_tunnel '1'

config models 'models'
	# Model updates (from cortex through the bridge, or 'agctl model install')
	# are used only when signed by a key you trust ('agctl trust <key.pub>'),
	# and are loaded without a restart. The packaged models stay as fallback.
	# option dir '/etc/aigw/models'
	# option keys '/etc/aigw/keys.d'
	option require_signature '1'

config lan 'lan'
	# interfaces whose clients AIGW looks after (DNS interception, and the
	# flow sensor only follows clients on these networks)
	list iface 'br-lan'
