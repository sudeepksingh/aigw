# AIGW configuration (UCI format, same file on OpenWRT and on a PC as AP).
# Location: /etc/config/aigw    Apply changes: restart the service.

config aigw 'main'
	option enabled '1'
	option log_level 'info'
	# DHCP leases file; leave unset for the platform default
	# option leases '/tmp/dhcp.leases'
	# device history; '' turns saving off. OpenWRT saves hourly to spare flash.
	# option state_file '/etc/aigw/agd-state.json'
	# option state_interval '3600'

config dns 'dns'
	# agdns listens here; client DNS on the LAN interfaces is redirected to it
	option listen '0.0.0.0'
	option port '5300'
	# 'auto' = dnsmasq on OpenWRT, first resolv.conf nameserver elsewhere.
	# Or an address: '1.1.1.1' / '9.9.9.9#53'
	option upstream 'auto'
	option intercept '1'
	# answers kept and served with their TTLs counted down; 0 turns the cache off
	option cache '1000'
	# refresh a name in use shortly before it expires, so it never waits for upstream
	option prefetch '1'
	# seconds an expired answer may still be served (TTL 30) when upstream fails
	# or takes longer than 1.8 s (RFC 8767); 0 = never
	option stale '86400'
	# longest an answer counts as fresh, whatever its TTL
	option max_ttl '86400'

config flow 'flow'
	# what devices connect to and how much they transfer (conntrack)
	option enabled '1'
	# seconds between traffic counter refreshes
	option poll '30'
	# seconds after start before flagging "connection without a DNS lookup"
	option warmup '600'
	# name HTTPS connections from their TLS / QUIC handshake (the server name a
	# device asks for), also when it skipped AIGW's DNS. The kernel copies the
	# first packets of each new connection to agd (NFLOG); nothing waits for it.
	option sni '1'
	# NFLOG group for those copies; change it only if another program uses it
	option sni_group '4419'

config meter 'meter'
	# count each device's traffic in the kernel as it passes (an eBPF program on
	# the LAN interfaces, Linux 6.6+): live rates per device. It only counts,
	# and is gone when agd stops.
	option enabled '1'

config fastpath 'fastpath'
	# established connections of devices AIGW isn't acting on skip the
	# forwarding rules (kernel flowtable): much faster forwarding on routers.
	# A device under an action stays on the slow path. On OpenWRT, keep fw4's
	# own flow offloading off: it would also offload devices AIGW acts on.
	option enabled '0'
	# '1': let the switch chip forward them (MT7621, Filogic); the meter then
	# doesn't see those packets
	option offload '0'
	# interfaces traffic comes in on: default the LAN interfaces and the one
	# with the default route
	# option ifaces 'br-lan wan'

config alerts 'alerts'
	# alerts explain what AIGW noticed; acting on them is set in 'act' below
	option enabled '1'
	# domain-risk score (0-1) at which a lookup is called machine-generated
	option dga_threshold '0.98'
	# shorter registrable names are not judged
	option dga_min_label '8'
	# lookup bursts: malware trying generated names until one answers, caught
	# by behaviour whatever the names look like. A device whose lookups of
	# names nobody here ever used get "no such name" at least burst_min times
	# within burst_window seconds, and at least burst_share of the time
	option burst '1'
	option burst_window '600'
	option burst_min '8'
	option burst_share '0.75'
	# federated learning: your answers train a shared layer with other homes;
	# names never leave, each round sends 14 noisy numbers (needs the bridge)
	option fed '1'
	# at least this much noise on what leaves, whatever cortex asks (privacy)
	option fed_noise '1.0'
	# stop taking part before the privacy spent (epsilon) passes this; 0 = no limit
	option fed_budget '0'

config baseline 'baseline'
	# what is normal for each device, learned continuously
	# watch a device this long, and until it has used this many sites, before judging it
	option learn_minutes '1440'
	option min_known '20'
	# devices picking up fewer new sites per day count as "stable" (IoT);
	# only they raise new-destination alerts (phones and laptops don't)
	option novelty_max '2'
	# upload alert: this many standard deviations above usual, and at least this many MB in an hour
	option spike_factor '6'
	option spike_min_mb '50'
	# days of history before "active at an unusual hour" alerts
	option unusual_min_days '7'

config mgmt 'mgmt'
	# management by an ISP over USP (TR-369; package aigw-usp) or TR-069
	# (package aigw-cwmp): one data model for both (agctl dm get Device.).
	# Off by default.
	option enabled '0'
	# may a management system quarantine, block and change act.mode? It may
	# always read, and approve, reject or undo what AIGW proposes. AIGW's
	# guardrails (protect, time limits) hold either way.
	option actions '0'
	# may it see alert subjects and reasons (the names devices looked up)?
	option alert_details '0'
	# this gateway's identity for both protocols (DeviceInfo.SerialNumber,
	# ManufacturerOUI); default: from the machine id, else the LAN MAC
	# option serial ''
	# option oui ''
	# an OEM's or ISP's names (DeviceInfo.Manufacturer, ModelName,
	# ProductClass); default: AIGW OS
	# option manufacturer ''
	# option model_name ''
	# option product_class ''
	# the vendor prefix of AIGW's own parameters (TR-106): X_<your OUI>_ or
	# X_<your domain, upper case, '.' as '-'>_, e.g. X_00D09E_ or
	# X_EXAMPLE-COM_. Default X_AIGW_. Set it before an ACS or controller
	# starts using the names: they change with it.
	# option vendor_prefix ''
	# may a management system change the Wi-Fi name, passphrase, security
	# mode, channel and width? upgrade the firmware?
	option wifi '1'
	option firmware '1'
	# may it reboot the gateway, or reset it to factory settings?
	option reset '1'
	# the program that downloads, checks and activates firmware; default: the
	# platform's (OpenWRT: sysupgrade). An OEM with A/B flash or signed images
	# names its own (docs/device-management.md, "The firmware handler")
	# option firmware_handler ''

config usp 'usp'
	# the ISP's MQTT broker and controller (aigw-usp); TLS by default
	# option broker 'usp.example.net'
	option port '8883'
	option tls '1'
	# option username ''
	# option password ''
	# this gateway's USP endpoint ID; default proto::aigw-<machine id>
	# option agent_id 'proto::aigw-1234'
	option controller_id 'self::usp-controller'
	# option agent_topic '/usp/agent/<agent_id>'
	option controller_topic '/usp/controller'
	# option ca_file '/etc/ssl/certs/ca-certificates.crt'
	# this gateway's TLS client certificate, if the ISP issues them: one PEM
	# file with the certificate and its key
	# option client_cert '/etc/aigw/usp/client.pem'

config cwmp 'cwmp'
	# the ISP's ACS (aigw-cwmp: icwmp with AIGW's data model). An ACS may change
	# url, username, password and the periodic inform settings itself
	# (Device.ManagementServer.*): they are saved here.
	# option url 'https://acs.example.net:7547/'
	# option username ''
	# option password ''
	option periodic_enable '1'
	option periodic_interval '86400'
	# connection requests from the ACS: port and credentials
	option port '7547'
	# option cr_username ''
	# option cr_password ''
	# option provisioning_code ''
	# the WAN interface (netifd name) the ACS is reached through; on a PC,
	# also its device (there is no netifd)
	option wan 'wan'
	# option wan_device 'eth0'
	# option ca_file '/etc/ssl/certs/ca-certificates.crt'
	# this gateway's TLS client certificate and key (PEM), if the ACS asks for one
	# option client_cert '/etc/aigw/cwmp/client.crt'
	# option client_key '/etc/aigw/cwmp/client.key'

config act 'act'
	# What AIGW may do about what it notices:
	#   off      alerts only, no actions proposed
	#   advise   policies propose actions; nothing changes until you approve
	#            (agctl decisions / agctl approve <id>)
	#   enforce  policies act on their own, within the guardrails below
	option mode 'advise'
	# every action ends by itself: default and maximum life, in seconds
	option ttl '3600'
	option max_ttl '86400'
	# enforce mode: at most this many automatic actions per hour, then they wait for you
	option max_auto_per_hour '3'
	# default speed limit for 'throttle', kbit/s
	option throttle_kbps '2000'
	# devices AIGW never acts on (MAC, IP or name), e.g. your own laptop
	# list protect 'aa:bb:cc:dd:ee:ff'
	# block list agdns reads; leave unset for the platform default (in RAM)
	# option dns_policy '/run/aigw/dns-policy'

# Policies: when an alert is raised, which action to propose. A policy's own
# mode can only be weaker than act.mode. Actions: quarantine, disconnect,
# throttle (with option rate, kbit/s), deprioritize, priority, channel (Wi-Fi),
# stay24 (keep a device on 2.4 GHz), or a plug-in's
# action ("<plugin>.<action>", see agctl plugins). 'option zone iot' limits a
# policy to devices in that zone. Skills (plug-ins) bring policies of their own.
# (Blocking a domain is never automatic: run 'agctl block <domain>'.)
# Without any policy sections, these five are built in.
config policy 'dga'
	option alert 'dga'
	option action 'quarantine'
	option ttl '3600'

config policy 'iot_new_site'
	# only "stable" devices (cameras, plugs, TVs) raise new-destination alerts
	option alert 'new-destination'
	option action 'quarantine'

config policy 'dga_burst'
	# many never-used names that don't exist, from one device (malware hunting
	# for its control server; the alert names the server when one answers)
	option alert 'dga-burst'
	option action 'quarantine'
	option ttl '3600'

config policy 'known_threat'
	# a name on the shared threat list from cortex (agctl models: threat-intel)
	option alert 'known-threat'
	option action 'quarantine'
	option ttl '3600'

config policy 'wifi_busy'
	# an access point's channel stays crowded: move it to a quieter one for a day
	# (clients follow without dropping), then back and judged again
	option alert 'wifi-busy'
	option action 'channel'
	option ttl '86400'

config policy 'wifi_congestion'
	# Self-Healing Wi-Fi: devices lose traffic though their signal is fine:
	# try a quieter channel, measure it, keep it if it is better, else back
	option alert 'wifi-congestion'
	option action 'channel'
	option ttl '3600'

config policy 'wifi_hopping'
	# a device keeps hopping to a 5 GHz it can barely reach: keep it on 2.4 GHz
	# for a day (refused on the 5 GHz access points only)
	option alert 'wifi-hopping'
	option action 'stay24'
	option ttl '86400'

# config policy 'upload_spike'
#	option alert 'upload-spike'
#	option action 'throttle'
#	option rate '1000'
#	option mode 'advise'

config wifi 'wifi'
	# hostapd control sockets; leave unset for the platform default
	# option ctrl_dir '/var/run/hostapd'
	# Self-Healing Wi-Fi (docs/self-healing-wifi.md): measure what each device
	# in use feels (loss, delay), learn the home's normal, name what is wrong
	# (congestion, weak coverage, band hopping, one device, the radio)
	option heal '1'
	# a problem: this % of lost probes, or this many ms (and 3x the device's usual)
	# option heal_loss '5'
	# option heal_delay '100'
	# a weak signal (dBm), and band changes in 10 minutes that count as hopping
	# option heal_weak '-75'
	# option heal_hops '4'
	# act on it (through act.mode and the wifi_congestion / wifi_hopping
	# policies): congestion held this many seconds starts a channel trial,
	# judged after heal_trial seconds; another trial at most every heal_retry
	# option heal_act '1'
	# option heal_hold '300'
	# option heal_trial '180'
	# option heal_retry '1800'
	# the program that saves and applies Wi-Fi settings a management system
	# changes; default: the platform's (OpenWRT: /etc/config/wireless; a PC:
	# /etc/aigw/pc-ap.conf). An OEM with its own Wi-Fi stack names its own
	# option handler ''
	# per-device Wi-Fi keys (agctl key add <name>): agd keeps them in this
	# hostapd wpa_psk_file. PC as AP sets it up; on OpenWRT add to the Wi-Fi
	# interface: uci set wireless.default_radio0.wpa_psk_file='/etc/aigw/wifi-keys'
	# option keys '/etc/aigw/wifi-keys'
	# an unused key expires after this many seconds
	# option key_ttl '86400'
	# Band steering: with a 2.4 GHz and a 5 GHz access point with the same name
	# (a dual-band router, or BAND=dual on a PC with two adapters), move each
	# device to the band that suits it. Devices with 802.11v are asked to move;
	# others (steer_kick) are refused on their band for 30 s and disconnected.
	option steer '1'
	# to 5 GHz at this signal or better, to 2.4 GHz at this signal or worse (dBm)
	option steer_up '-60'
	option steer_down '-75'
	# seconds the signal must stay past the line; seconds between moves of one
	# device; most moves a minute in the home. Devices in act.protect are never moved.
	option steer_hold '30'
	option steer_gap '300'
	option steer_rate '2'
	option steer_kick '1'
	# a device unseen this long has left home (phones drop Wi-Fi to save power)
	option presence_away '600'
	# Channel self-healing: how busy each access point's channel is (the radio's
	# survey), measured every chan_poll seconds; busier than chan_busy % for
	# chan_hold seconds raises 'wifi-busy' with a quieter channel from a scan of
	# the neighbours (at most every chan_scan_gap seconds; a scan leaves the
	# channel for a moment). The wifi_busy policy turns it into a 'channel' action.
	option chan_heal '1'
	option chan_busy '60'
	option chan_hold '1800'
	option chan_poll '30'
	option chan_scan_gap '21600'

config plugins 'plugins'
	# Plug-ins wire themselves in, no configuration needed: packages put them
	# in /usr/share/aigw/plugins (trusted); 'agctl plugin add <folder>' puts
	# yours in /etc/aigw/plugins, whose privileged capabilities wait for
	# 'agctl plugin allow <name>'. See: agctl plugins
	option enabled '1'
	# plug-ins run as this unprivileged user
	option user 'nobody'
	# each plug-in's own writable directory is <state_dir>/<name>
	# option state_dir '/var/run/aigw/plugins'

# Settings for one plug-in become its configuration; 'enabled 0' turns it off.
# 'agctl plugin config <name> <key> <value>' sets them and restarts the plug-in.
# config plugin 'mqtt'
#	option broker '192.168.1.10'
#	option port '1883'
#	option username 'aigw'
#	option password 'secret'
#	option homeassistant '1'

# The bridge to cortex (package aigw-bridge): 'agctl bridge <url>', then
# 'agctl bridge token' (paste the token from 'aigw_cortex enroll').
# config plugin 'bridge'
#	option url 'https://cortex.example.net:8790'
#	option token '...'
#	option interval '300'
#	# names | anonymous (no names, addresses or alert reasons) | none
#	option devices 'names'
#	option models '1'
#	option proposals '1'

config remote 'remote'
	# Remote access over WireGuard: 'agctl remote on <public address or DDNS
	# name>', then 'agctl remote add <name>' for a QR code. Behind another
	# router, forward UDP <port> to this gateway.
	option enabled '0'
	# option endpoint 'home.example.net'
	# option port '51820'
	# option subnet '10.77.0.0/24'
	# 1: all of a phone's traffic goes home, so AIGW protects it everywhere;
	# 0: only the tunnel and the home networks
	# option full_tunnel '1'

config models 'models'
	# Model updates (from cortex through the bridge, or 'agctl model install')
	# are used only when signed by a key you trust ('agctl trust <key.pub>'),
	# and are loaded without a restart. The packaged models stay as fallback.
	# option dir '/etc/aigw/models'
	# option keys '/etc/aigw/keys.d'
	option require_signature '1'
	# who computes the model's scores: 'auto' (the fastest back-end that gives
	# the reference's verdicts), 'interp' (the reference), 'flat' (built in,
	# same scores, faster), or a back-end a package added (an NPU's), by name
	option backend 'auto'
	# back-end libraries; root's only (a package puts them here)
	# option backend_dir '/usr/lib/aigw/backends'

config lan 'lan'
	# interfaces whose clients AIGW looks after (DNS interception, and the
	# flow sensor only follows clients on these networks)
	list iface 'br-lan'
