#!/bin/sh /etc/rc.common
# AIGW on OpenWRT: starts the brain (agd) and the DNS sensor (agdns) under
# procd, then loads the AIGW nftables table.

START=95
STOP=10
USE_PROCD=1

start_service() {
	local enabled

	config_load aigw
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0
	command -v nft >/dev/null || {
		logger -t aigw "nft not found: AIGW needs firewall4 (OpenWRT 22.03 or newer)"
		return 1
	}

	procd_open_instance agd
	procd_set_param command /usr/sbin/agd
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance agdns
	procd_set_param command /usr/sbin/agdns
	procd_set_param respawn 3600 1 0
	procd_set_param stderr 1
	procd_close_instance

	/usr/sbin/aigw-nft apply
}

stop_service() {
	/usr/sbin/aigw-nft remove
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "aigw"
}
