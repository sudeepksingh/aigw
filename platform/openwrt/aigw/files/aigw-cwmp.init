#!/bin/sh /etc/rc.common
# AIGW OS management by TR-069: icwmp with the AIGW OS data model (aigw-cwmp-dm).
# Starts only with aigw.mgmt.enabled 1 and aigw.cwmp.url set. Opens the
# connection request port (aigw.cwmp.port, 7547) on the WAN zone, for the ACS.

START=96
STOP=10
USE_PROCD=1

firewall_rule() {
	port=$(uci -q get aigw.cwmp.port || echo 7547)
	[ "$(uci -q get firewall.aigw_cwmp.dest_port)" = "$port" ] && return 0
	uci -q batch <<EOF
set firewall.aigw_cwmp=rule
set firewall.aigw_cwmp.name='Allow-AIGW-TR069-connection-requests'
set firewall.aigw_cwmp.src='wan'
set firewall.aigw_cwmp.proto='tcp'
set firewall.aigw_cwmp.dest_port='$port'
set firewall.aigw_cwmp.target='ACCEPT'
commit firewall
EOF
	fw4 reload 2>/dev/null || true
}

start_service() {
	[ "$(uci -q get aigw.mgmt.enabled)" = 1 ] || return 0
	[ -n "$(uci -q get aigw.cwmp.url)" ] || {
		logger -t aigw-cwmp "no ACS set (uci set aigw.cwmp.url=<ACS URL>)"
		return 0
	}
	firewall_rule
	procd_open_instance
	procd_set_param command /usr/sbin/aigw-cwmp-run
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger aigw
}
