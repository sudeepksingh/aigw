#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# mesh-prplmesh: AIGW OS's mesh handler for prplMesh, the reference
# Wi-Fi Alliance EasyMesh controller (prplOS, OpenWRT). agd reads the mesh and
# acts through it; it checks every value before it calls this.
#
#   mesh-prplmesh get <file>
#       the controller's Data Elements model, Device.WiFi.DataElements.Network.,
#       into <file>: JSON from ubus (Ambiorix's _get, as prplMesh's own tools
#       read it), else "path=value" lines from ubus-cli / ba-cli
#   mesh-prplmesh steer <station MAC> <target BSSID> <btm|mandate>
#       Network.ClientSteering(station_mac, target_bssid): prplMesh sends an
#       802.11v BTM request, or uses its blocklist for a device without one
#   mesh-prplmesh channel <radio RUID> <channel> <opclass> <centre> <width MHz>
#       prplMesh's on-demand channel selection (BML: bml_trigger_channel_selection;
#       its NBAPI has no channel request yet)
#
# Exit 0 done, 2 usage, 3 no controller here, 1 the controller refused (its
# last line says why).
#
# Another controller (an OEM's, or one that speaks the TR-181 2.17+ commands
# STA.{i}.ClientSteer() and Radio.{i}.ChannelSelectionRequest()) plugs in with
# its own program with the same interface: mesh.handler in /etc/config/aigw.
set -u

OBJ=Device.WiFi.DataElements.Network

usage() { echo "usage: mesh-prplmesh get <file> | steer <sta> <bssid> <btm|mandate> | channel <ruid> <ch> <opclass> <centre> <width>" >&2; exit 2; }
mac_ok() { echo "$1" | grep -Eq '^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$'; }
num_ok() { for v in "$@"; do case "$v" in ''|*[!0-9]*) return 1 ;; esac; done; return 0; }
on_ubus() { command -v ubus >/dev/null 2>&1 && ubus -S list "$OBJ" 2>/dev/null | grep -q .; }

case "${1:-}" in
get)
	[ -n "${2:-}" ] || usage
	if on_ubus; then
		ubus -t 10 call "$OBJ" _get '{"depth":"10"}' > "$2" 2>/dev/null && [ -s "$2" ] && exit 0
	fi
	for cli in ubus-cli ba-cli; do
		command -v "$cli" >/dev/null 2>&1 || continue
		"$cli" "$OBJ.?" 2>/dev/null | grep '^Device\.WiFi\.DataElements\.' > "$2" && [ -s "$2" ] && exit 0
	done
	echo "no EasyMesh controller: $OBJ is not on ubus (is prplMesh's controller running here?)"
	exit 3
	;;
steer)
	[ $# -eq 4 ] && mac_ok "$2" && mac_ok "$3" || usage
	on_ubus || { echo "no EasyMesh controller on ubus"; exit 3; }
	out=$(ubus -t 10 call "$OBJ" ClientSteering "{\"station_mac\":\"$2\",\"target_bssid\":\"$3\"}" 2>&1) ||
		{ echo "ClientSteering: ${out:-failed}"; exit 1; }
	echo "asked prplMesh to steer $2 to $3 ($4)"
	;;
channel)
	[ $# -eq 6 ] && mac_ok "$2" && num_ok "$3" "$4" "$5" "$6" || usage
	bcli=$(command -v beerocks_cli || echo /opt/prplmesh/bin/beerocks_cli)
	[ -x "$bcli" ] || { echo "beerocks_cli not found: prplMesh takes channel requests only through its BML"; exit 1; }
	out=$("$bcli" -c "bml_trigger_channel_selection $2 $3 $6" 2>&1) || { echo "channel selection: ${out:-failed}"; exit 1; }
	echo "$out" | grep -qi 'fail\|error' && { echo "channel selection: $(echo "$out" | tail -n 1)"; exit 1; }
	echo "asked prplMesh to move radio $2 to channel $3 ($6 MHz, class $4)"
	;;
*)
	usage
	;;
esac
exit 0
