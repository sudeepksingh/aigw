#!/bin/sh /etc/rc.common
# AIGW OS management by USP (TR-369): OB-USP-Agent with the AIGW OS data model.
# Starts only with aigw.mgmt.enabled 1 and aigw.usp.broker set.

START=96
STOP=10
USE_PROCD=1

start_service() {
	[ "$(uci -q get aigw.mgmt.enabled)" = 1 ] || return 0
	[ -n "$(uci -q get aigw.usp.broker)" ] || {
		logger -t aigw-usp "no MQTT broker set (uci set aigw.usp.broker=<host>)"
		return 0
	}
	procd_open_instance
	procd_set_param command /usr/sbin/aigw-usp-run
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger aigw
}
