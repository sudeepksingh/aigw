#!/bin/sh
# aigw-ap: runs AIGW on this PC as a Wi-Fi access point.
#
#   sudo aigw-ap up        start the access point and the AIGW services
#   sudo aigw-ap down      stop everything and release the Wi-Fi adapter
#   sudo aigw-ap restart
#   sudo aigw-ap status
#
# Settings: /etc/aigw/pc-ap.conf
set -eu

CONF=${AIGW_PCAP_CONF:-/etc/aigw/pc-ap.conf}
RUN=${AIGW_RUN:-/run/aigw}
STATE=/var/lib/aigw
FW=/mnt/wsl/firmware
SERVICES="aigw-ubusd aigw-agd aigw-agdns"

say() { printf '%s\n' "$*"; }
die() { printf 'aigw-ap: %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" = 0 ] || die "run as root: sudo aigw-ap ${1:-up}"
[ -f "$CONF" ] || die "missing $CONF (run the installer first)"
# shellcheck disable=SC1090
. "$CONF"
AP_IFACE=${AP_IFACE:-auto}
SSID=${SSID:-AIGW}
PASSPHRASE=${PASSPHRASE:-}
COUNTRY=${COUNTRY:-}
BAND=${BAND:-2.4}
CHANNEL=${CHANNEL:-6}
WIDTH=${WIDTH:-auto}
# BAND=dual: two adapters, one access point per band, one name (band steering)
CHANNEL_24=${CHANNEL_24:-6}
WIDTH_24=${WIDTH_24:-20}
AP_IFACE_24=${AP_IFACE_24:-auto}
BRIDGE=aigwbr0
SUBNET=${SUBNET:-10.42.0}
UPLINK=${UPLINK:-auto}

is_wsl() { grep -qi microsoft /proc/version 2>/dev/null; }
have_systemd() { [ -d /run/systemd/system ]; }

wifi_ifaces() {
	for d in /sys/class/net/*; do
		[ -e "$d/phy80211" ] && basename "$d"
	done
	return 0
}

uplink_iface() {
	if [ "$UPLINK" != auto ]; then
		echo "$UPLINK"
		return
	fi
	ip -4 route show default | awk '{for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit }}'
}

supports_ap() {
	phy=$(basename "$(readlink -f "/sys/class/net/$1/phy80211")")
	iw phy "$phy" info 2>/dev/null | grep -qE '^[[:space:]]+\* AP$'
}

# WSL2 sees a USB adapter only after Windows hands it over (usbipd-win).
# WSL can run Windows programs, so do it from here: find the adapters in
# `usbipd list` (USB_BUSID in the config: one bus id or several, or every
# Wi-Fi device) and attach them. Sharing one (bind) needs administrator
# rights once; that stays with aigw-wsl.cmd. Never fatal: without an
# adapter, `up` explains. WSL_ADAPTERS = how many Wi-Fi adapters WSL has.
WSL_ADAPTERS=0
usbipd_exe() {
	for u in "$(command -v usbipd.exe 2>/dev/null)" "/mnt/c/Program Files/usbipd-win/usbipd.exe"; do
		[ -n "$u" ] && [ -x "$u" ] && { echo "$u"; return 0; }
	done
	return 1
}

wsl_attach() {
	is_wsl || return 0
	u=$(usbipd_exe) || { say "usbipd-win not found on Windows (winget install usbipd)"; return 0; }
	lines=$("$u" list 2>/dev/null | tr -d '\r' | sed -n '/^Connected:/,/^$/p' | grep -E '^[0-9]+-[0-9]+ ')
	if [ -n "${USB_BUSID:-}" ]; then
		pick=""
		for b in $USB_BUSID; do pick="$pick$(echo "$lines" | grep -E "^$b ")
"; done
	else
		pick=$(echo "$lines" | grep -iE 'wireless|wlan|wi-?fi|802\.11')
	fi
	echo "$pick" | grep -q . || { say "no USB Wi-Fi adapter plugged into Windows"; return 0; }
	ids=""
	echo "$pick" | grep . > "$RUN/usb-adapters"
	while read -r line; do
		bus=${line%% *}
		ids="$ids $(echo "$line" | awk '{print $2}')"
		case $line in
		*"Not shared"*)
			say "adapter $bus is not shared with WSL yet: run platform\\pc-ap\\wsl\\aigw-wsl.cmd once from Windows (asks for administrator approval)"
			continue ;;
		*Attached*)
			;;
		*)
			say "attaching USB adapter $bus to WSL"
			"$u" attach --wsl --busid "$bus" >/dev/null 2>&1 || { say "usbipd could not attach $bus"; continue; }
			;;
		esac
		WSL_ADAPTERS=$((WSL_ADAPTERS + 1))
	done < "$RUN/usb-adapters"
	# wait for the USB devices themselves; the Wi-Fi interfaces follow once
	# the driver finds its firmware (below)
	i=0
	while [ "$(usb_count $ids)" -lt "$WSL_ADAPTERS" ] && [ $i -lt 20 ]; do
		sleep 0.5
		i=$((i + 1))
	done
}

# USB devices with any of these vendor:product ids (two identical adapters count twice)
usb_count() {
	n=0
	for d in /sys/bus/usb/devices/*; do
		[ -f "$d/idVendor" ] || continue
		id="$(cat "$d/idVendor"):$(cat "$d/idProduct")"
		for want in "$@"; do
			[ "$id" = "$want" ] && { n=$((n + 1)); break; }
		done
	done
	echo "$n"
}

wifi_count() {
	wifi_ifaces | grep -c . || true
}

# WSL2's kernel cannot read the distro's /lib/firmware (or compressed
# firmware), so expose uncompressed copies on the shared /mnt/wsl tmpfs and
# reload the USB Wi-Fi driver. Also makes the regulatory database visible.
wsl_prepare() {
	is_wsl || return 0
	wsl_attach
	mkdir -p "$FW"
	for pattern in 'rtw88/*' 'rtw89/*' 'rtlwifi/*' 'rtl_bt/*' 'mediatek/WIFI_*MT79*' \
		'mediatek/mt76*' 'ath9k_htc/*' 'regulatory.db*'; do
		for f in /lib/firmware/$pattern; do
			[ -f "$f" ] || continue
			rel=${f#/lib/firmware/}
			out="$FW/${rel%.zst}"
			out=${out%.xz}
			[ -f "$out" ] && continue
			mkdir -p "$(dirname "$out")"
			case $f in
			*.zst) zstd -q -d -f "$f" -o "$out" ;;
			*.xz) xz -dc "$f" > "$out" ;;
			*) cp "$f" "$out" ;;
			esac
		done
	done
	printf '%s' "$FW" > /sys/module/firmware_class/parameters/path
	# fewer Wi-Fi interfaces than adapters: the driver gave up on firmware
	# before the path above existed; load it again
	if [ "$(wifi_count)" -eq 0 ] || [ "$(wifi_count)" -lt "$WSL_ADAPTERS" ]; then
		for m in rtw88_8821cu rtw88_8822bu rtw88_8822cu rtw88_8723du mt7921u mt76x2u mt76x0u rtl8xxxu ath9k_htc; do
			if lsmod | grep -q "^$m "; then
				modprobe -r "$m" 2>/dev/null || true
				modprobe "$m" || true
			fi
		done
		i=0
		while { [ "$(wifi_count)" -eq 0 ] || [ "$(wifi_count)" -lt "$WSL_ADAPTERS" ]; } && [ $i -lt 20 ]; do
			sleep 0.5
			i=$((i + 1))
		done
		sleep 2 # let udev finish renaming wlan0 -> wlx...
	fi
	iw reg reload 2>/dev/null || true
}

# Access-point capable adapters, the internet connection ($1) excepted.
# The ones named in AP_IFACE / AP_IFACE_24 come first, in that order.
ap_ifaces() {
	up_if=$1
	for i in "$AP_IFACE" "$AP_IFACE_24"; do
		[ "$i" != auto ] && [ "$i" != "$up_if" ] && [ -e "/sys/class/net/$i" ] && echo "$i"
	done
	for i in $(wifi_ifaces); do
		[ "$i" = "$up_if" ] || [ "$i" = "$AP_IFACE" ] || [ "$i" = "$AP_IFACE_24" ] && continue
		supports_ap "$i" && echo "$i"
	done
	return 0
}

# Channel width settings for hostapd: width $1 (20, 40 or 80 MHz) on band
# $2 channel $3. 40 MHz pairs the channel with its neighbour (HT40+ below,
# HT40- above); 80 MHz (5 GHz, 802.11ac) uses its block of four channels.
width_lines() {
	w=$1 band=$2 ch=$3
	[ "$w" = 20 ] && return 0
	if [ "$band" = 5 ]; then
		if [ "$ch" -ge 149 ]; then base=149; else base=36; fi
		if [ $(( (ch - base) / 4 % 2 )) = 0 ]; then echo "ht_capab=[HT40+]"; else echo "ht_capab=[HT40-]"; fi
		if [ "$w" = 80 ]; then
			echo "vht_oper_chwidth=1"
			echo "vht_oper_centr_freq_seg0_idx=$(( base + (ch - base) / 16 * 16 + 6 ))"
		fi
	else
		if [ "$ch" -le 7 ]; then echo "ht_capab=[HT40+]"; else echo "ht_capab=[HT40-]"; fi
	fi
}

# The widths to try on band $1 channel $2, widest first: what $3 asks for
# (20, 40, 80 or auto), then narrower ones.
widths() {
	band=$1 ch=$2 w=$3
	if [ "$w" = auto ]; then
		if [ "$band" = 5 ]; then w=80; else w=20; fi
	fi
	[ "$band" = 5 ] || [ "$w" != 80 ] || w=40       # 80 MHz is 5 GHz only
	[ "$band" = 5 ] && [ "$ch" = 165 ] && w=20      # channel 165 has no partner
	case $w in
	80) echo "80 40 20" ;;
	40) echo "40 20" ;;
	*) echo "20" ;;
	esac
}

# hostapd config for one access point: interface $1, width $2, band $3,
# channel $4, written to $5; $6 = bridge to join ("" = none)
write_hostapd() {
	iface=$1 width=$2 band=$3 ch=$4 out=$5 br=$6
	if [ "$band" = 5 ]; then
		[ -n "$COUNTRY" ] || die "5 GHz needs COUNTRY set in $CONF"
		hw_mode=a
	else
		hw_mode=g
	fi
	# per-device keys (agctl key add): hostapd refuses to start if the file is missing
	keys=${AIGW_WIFI_KEYS:-$(uci -q get aigw.wifi.keys || echo /etc/aigw/wifi-keys)}
	umask 077
	mkdir -p "$(dirname "$keys")"
	[ -f "$keys" ] || : > "$keys"
	{
		echo "interface=$iface"
		[ -n "$br" ] && echo "bridge=$br"
		echo "driver=nl80211"
		echo "ctrl_interface=$RUN/hostapd"
		echo "ssid=$SSID"
		echo "hw_mode=$hw_mode"
		echo "channel=$ch"
		if [ -n "$COUNTRY" ]; then
			echo "country_code=$COUNTRY"
			echo "ieee80211d=1"
		fi
		echo "ieee80211n=1"
		if [ "$band" = 5 ]; then echo "ieee80211ac=1"; fi
		width_lines "$width" "$band" "$ch"
		# 802.11v: devices can be asked to move to the other band (agd band steering)
		echo "bss_transition=1"
		echo "wmm_enabled=1"
		echo "auth_algs=1"
		echo "wpa=2"
		echo "wpa_key_mgmt=WPA-PSK"
		echo "rsn_pairwise=CCMP"
		echo "wpa_passphrase=$PASSPHRASE"
		echo "wpa_psk_file=$keys"
	} > "$out"
	umask 022
}

# One access point: interface $1, band $2, channel $3, width wanted $4,
# bridge $5. Tries narrower widths when hostapd refuses one; prints the
# width it runs at, or nothing.
start_ap() {
	iface=$1 band=$2 ch=$3 want=$4 br=$5
	for w in $(widths "$band" "$ch" "$want"); do
		write_hostapd "$iface" "$w" "$band" "$ch" "$RUN/hostapd-$iface.conf" "$br"
		# -B returns before the access point is really up (channel checks,
		# the 40 MHz neighbour scan); its state says whether it got there
		if hostapd -B -P "$RUN/hostapd-$iface.pid" "$RUN/hostapd-$iface.conf" > "$RUN/hostapd-$iface.log" 2>&1 &&
		   ap_enabled "$iface"; then
			echo "$w"
			return 0
		fi
		kill_pidfile "$RUN/hostapd-$iface.pid"
		say "hostapd refused $w MHz on channel $ch ($iface); trying narrower" >&2
	done
	cat "$RUN/hostapd-$iface.log" >&2
	return 0
}

# Wait up to 15 s for hostapd on $1 to say state=ENABLED. Without hostapd_cli,
# a hostapd still running after 3 s counts.
ap_enabled() {
	pidf="$RUN/hostapd-$1.pid"
	if ! command -v hostapd_cli >/dev/null; then
		sleep 3
		[ -f "$pidf" ] && kill -0 "$(cat "$pidf")" 2>/dev/null
		return
	fi
	i=0
	while [ $i -lt 30 ]; do
		st=$(hostapd_cli -p "$RUN/hostapd" -i "$1" status 2>/dev/null | sed -n 's/^state=//p')
		[ "$st" = ENABLED ] && return 0
		[ -f "$pidf" ] && kill -0 "$(cat "$pidf")" 2>/dev/null || return 1
		sleep 0.5
		i=$((i + 1))
	done
	return 1
}

stop_aps() {
	for p in "$RUN"/hostapd*.pid; do
		[ -f "$p" ] && kill_pidfile "$p"
	done
	return 0
}

kill_pidfile() {
	if [ -f "$1" ]; then
		kill "$(cat "$1")" 2>/dev/null || true
		rm -f "$1"
	fi
}

start_services() {
	if have_systemd; then
		systemctl start $SERVICES
	else
		for s in ubusd agd agdns; do
			bin=$(command -v "$s" || true)
			[ -n "$bin" ] || die "$s not installed"
			nohup "$bin" > "$RUN/$s.log" 2>&1 &
			echo $! > "$RUN/$s.pid"
			if [ "$s" = ubusd ]; then sleep 0.5; fi
		done
	fi
}

stop_services() {
	if have_systemd; then
		systemctl stop aigw-agdns aigw-agd 2>/dev/null || true
	else
		for s in agdns agd ubusd; do kill_pidfile "$RUN/$s.pid"; done
	fi
}

up() {
	mkdir -p "$RUN" "$STATE"
	wsl_prepare

	up_if=$(uplink_iface)
	[ -n "$up_if" ] || die "no internet connection found (no default route)"
	set -- $(ap_ifaces "$up_if")
	[ $# -ge 1 ] || die "no Wi-Fi adapter with AP mode found.$(is_wsl && echo " On WSL: is the USB adapter plugged in and shared? (usbipd list; platform/pc-ap/wsl/aigw-wsl.cmd shares it once)")"
	[ -e "/sys/class/net/$1" ] || die "interface $1 not found"
	[ "$1" != "$up_if" ] || die "$1 is your internet connection; set AP_IFACE to another adapter in $CONF"
	[ ${#PASSPHRASE} -ge 8 ] || die "PASSPHRASE must be 8-63 characters ($CONF)"
	for t in hostapd dnsmasq nft iw; do command -v $t >/dev/null || die "$t not installed"; done

	# what runs where: one band on the first adapter, or both bands on two
	mode=$BAND ch5=$CHANNEL
	if [ "$BAND" = dual ]; then
		if [ $# -lt 2 ]; then
			say "BAND=dual needs two Wi-Fi adapters; found one ($1): running 5 GHz only"
			mode=5
		fi
		[ "$ch5" -ge 36 ] 2>/dev/null || ch5=36   # CHANNEL may still hold a 2.4 GHz channel
	fi
	iface=$1 iface24=""
	[ "$mode" = dual ] && iface24=$2

	# take the adapters away from other Wi-Fi managers
	for i in $iface $iface24; do
		if command -v nmcli >/dev/null; then nmcli device set "$i" managed no 2>/dev/null || true; fi
	done
	if [ -n "$COUNTRY" ]; then
		# the kernel reads the regulatory database once; reload it (a newly
		# installed wireless-regdb) before setting the country
		iw reg reload 2>/dev/null || true
		iw reg set "$COUNTRY" 2>/dev/null || true
		sleep 0.5
		if ! iw reg get 2>/dev/null | grep -q "^country $COUNTRY"; then
			say "warning: the kernel did not take country $COUNTRY ($(iw reg get 2>/dev/null | grep -m1 '^country'));"
			say "         5 GHz may be refused (NO-IR). Install wireless-regdb, then: sudo iw reg reload"
		fi
	fi

	stop_aps
	kill_pidfile "$RUN/dnsmasq.pid"
	ip link del "$BRIDGE" 2>/dev/null || true
	for i in $iface $iface24; do ip addr flush dev "$i"; done

	if [ "$mode" = dual ]; then
		# both access points in one bridge: one network, so a device keeps its
		# address when it moves between bands
		lan_if=$BRIDGE
		ip link add "$BRIDGE" type bridge
		ip link set "$BRIDGE" up
		ip addr add "$SUBNET.1/24" dev "$BRIDGE"
		w5=$(start_ap "$iface" 5 "$ch5" "$WIDTH" "$BRIDGE")
		[ -n "$w5" ] || die "hostapd could not start the 5 GHz access point on $iface"
		w24=$(start_ap "$iface24" 2.4 "$CHANNEL_24" "$WIDTH_24" "$BRIDGE")
		if [ -z "$w24" ]; then
			stop_aps
			die "hostapd could not start the 2.4 GHz access point on $iface24"
		fi
		ip link set "$iface" up
		ip link set "$iface24" up
		desc="$iface 5 GHz channel $ch5 ($w5 MHz) + $iface24 2.4 GHz channel $CHANNEL_24 ($w24 MHz), band steering"
	else
		lan_if=$iface
		ip addr add "$SUBNET.1/24" dev "$iface"
		chan=$CHANNEL
		[ "$mode" = 5 ] && chan=$ch5
		w=$(start_ap "$iface" "$mode" "$chan" "$WIDTH" "")
		[ -n "$w" ] || die "hostapd could not start the access point on $iface"
		ip link set "$iface" up
		desc="$iface, $mode GHz channel $chan, $w MHz wide"
	fi

	dnsmasq --conf-file=/dev/null --port=0 --interface="$lan_if" --bind-interfaces \
		--except-interface=lo --dhcp-authoritative \
		--dhcp-range="$SUBNET.20,$SUBNET.250,255.255.255.0,12h" \
		--dhcp-option=option:router,"$SUBNET.1" \
		--dhcp-option=option:dns-server,"$SUBNET.1" \
		--dhcp-leasefile="$STATE/dnsmasq.leases" \
		--dhcp-script="$(command -v aigw-dhcp-event || echo /usr/local/sbin/aigw-dhcp-event)" \
		--pid-file="$RUN/dnsmasq.pid" \
		|| die "dnsmasq (DHCP) failed to start"

	sysctl -qw net.ipv4.ip_forward=1
	# the flow sensor reads connection events from conntrack
	modprobe nf_conntrack_netlink 2>/dev/null || true
	nft -f - <<EOF
table ip aigw_nat
delete table ip aigw_nat
table ip aigw_nat {
	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		ip saddr $SUBNET.0/24 oifname "$up_if" masquerade
	}
}
EOF

	uci -q delete aigw.lan.iface || true
	uci add_list aigw.lan.iface="$lan_if"
	uci commit aigw
	echo "$lan_if" > "$RUN/iface"
	echo "$iface $iface24" > "$RUN/radios"

	start_services
	sleep 1
	aigw-nft apply

	say "AIGW OS access point is up"
	say "  Wi-Fi     $SSID  (password in $CONF)"
	say "  adapter   $desc"
	say "  clients   $SUBNET.20-250, internet via $up_if"
	say "Watch it:  agctl watch all   |   agctl devices   |   sudo aigw-ap status"
}

down() {
	aigw-nft remove 2>/dev/null || true
	stop_services
	kill_pidfile "$RUN/dnsmasq.pid"
	stop_aps
	nft delete table ip aigw_nat 2>/dev/null || true
	for i in $(cat "$RUN/radios" 2>/dev/null) $(cat "$RUN/iface" 2>/dev/null); do
		ip addr flush dev "$i" 2>/dev/null || true
		ip link set "$i" down 2>/dev/null || true
	done
	ip link del "$BRIDGE" 2>/dev/null || true
	rm -f "$RUN/iface" "$RUN/radios"
	say "AIGW OS access point is down"
}

status() {
	if [ ! -f "$RUN/iface" ]; then
		say "access point: down"
		return 0
	fi
	for iface in $(cat "$RUN/radios" 2>/dev/null || cat "$RUN/iface"); do
		say "access point: $iface"
		iw dev "$iface" info 2>/dev/null | grep -E 'ssid|type|channel' | sed 's/^[[:space:]]*/  /'
		say "  clients: $(iw dev "$iface" station dump 2>/dev/null | grep -c '^Station' || true)"
	done
	if have_systemd; then
		for s in $SERVICES; do say "service $s: $(systemctl is-active "$s" 2>/dev/null || true)"; done
	fi
	agctl status 2>/dev/null || true
}

case "${1:-}" in
up) up ;;
down) down ;;
restart) down; up ;;
status) status ;;
channel)   # one access point to another channel, until the next `up` (agd's channel action
	   # uses this where the radio can't announce a switch): channel <iface> <channel>
	[ $# -ge 3 ] || die "usage: aigw-ap channel <iface> <channel>"
	c="$RUN/hostapd-$2.conf"
	[ -f "$c" ] || die "no access point on $2"
	band=5
	if grep -q '^hw_mode=g' "$c"; then band=2.4; fi
	w=20
	if grep -q '^vht_oper_chwidth=1' "$c"; then w=80; elif grep -q '^ht_capab=\[HT40' "$c"; then w=40; fi
	br=$(sed -n 's/^bridge=//p' "$c")
	kill_pidfile "$RUN/hostapd-$2.pid"
	got=$(start_ap "$2" "$band" "$3" "$w" "$br")
	[ -n "$got" ] || die "hostapd could not start $2 on channel $3"
	say "$2 now on channel $3 ($got MHz)" ;;
conf)   # the hostapd config `up` writes: conf <iface> <band> <channel> <width> [bridge]
	[ $# -ge 5 ] || die "usage: aigw-ap conf <iface> <2.4|5> <channel> <20|40|80> [bridge]"
	mkdir -p "$RUN"
	write_hostapd "$2" "$5" "$3" "$4" /dev/stdout "${6:-}" ;;
*) echo "usage: sudo aigw-ap up|down|restart|status" >&2; exit 1 ;;
esac
