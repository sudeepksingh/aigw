[Unit]
Description=AIGW OS management by TR-069 (icwmp with the AIGW OS data model)
Wants=aigw-agd.service
After=aigw-agd.service network-online.target
ConditionPathExists=@SBINDIR@/icwmpd

[Service]
# reads /etc/config/aigw (sections mgmt and cwmp); exits when mgmt.enabled is 0.
# On a PC set aigw.cwmp.wan_device to the interface towards the ACS (no netifd).
ExecStart=@SBINDIR@/aigw-cwmp-run
Restart=on-failure
RestartSec=10
